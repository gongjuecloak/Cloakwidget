# ============ 构建产物 ============
*.exe
/dist/
mes_conv/*.syso
mes_conv/out/
mes_conv/logs/
mes_conv/backup/
mes_conv/configs/
# 运行期自动更新状态（记录上次检查时间，避免每次启动都打 GitHub）
mes_conv/autoupdate.json
# 更新状态机：待确认启动 / 已确认版本 / 回滚记录（运行期状态，每台机器不同）
mes_conv/update_state.json
# 更新目录锁与「落位失败待重试」标记
mes_conv/update.lock
mes_conv/pending_apply.json
# 旧版本 exe 归档（启动自检通过后从 .old / .bad 归档过来，体积以 MB 计）
mes_conv/previous/
# 上次运行的版本号（用于「刚升级过就弹一次更新日志」，运行期状态）
mes_conv/last_version.txt
# 配置原子写入的临时文件（os.CreateTemp 生成的隐藏唯一名）
mes_conv/*.json.tmp
mes_conv/.*.json.*.tmp
# 就地更新时的临时文件
*.new
*.old
*.bad
# 更新落位记录（记录下次启动要清理的旧 exe，运行期状态）
pending_update.txt
_pkg/

# 运行期生成的配置 / 状态（首次运行由程序自动写出，仓库里只保留内置默认值）
mes_conv/orders.json
mes_conv/bom_mapping.json
mes_conv/tpl_baseline.json
mes_conv/sys_settings.json
mes_conv/welcomed

# ============ 分享版构建产物 ============
# build.sh 会在本地生成整个目录；仓库只保留源码。
/MES物料档案转换工具_分享版/

# 分享用的打包产物（内含 exe，同样不入库）
/MES物料档案转换工具_*.zip

# ============ 临时文件 ============
_golden/
_chrome_prof/
_chrome_prof_*/
__pycache__/
share_dist/
_dom.html
_check.js
_shot_*.js
_shot_*.png
_probe_*.js
_wjs_check.js
_extract_js.js
_syntax.js
_vi.txt
_wt_backup*.html
_backup_webui_*.html
*.xlsx
*.log
*.bak
*.bak_*
# 例外：内置输出模板（已剔除全部业务数据，只含表头+样式，入库前扫描确认）
!mes_conv/templates/*.xlsx

# ============ 测试夹具：真实业务数据，一律不入库 ============
# 本仓库公开，夹具含真实物料与订单数据（客户简称、品号、金额等）。
# 只保留目录本身，文件请自行从 MES 导出目录放置后再跑（见 _fmttest/README.md）。
_fixtures/*
!_fixtures/.gitkeep

_fmttest/*.xls
_fmttest/*.csv
_fmttest/out_*.xlsx

# ============ 工作区本地笔记 ============
.workbuddy/

# ============ 归档目录：早期排查脚本与历史截图（不入库） ============
# 这些是早期的数据探查 / 旧版验证工具，已移入 _archive/ 留档。
# 注意：不要用裸文件名规则（如 cmp.py），否则会误伤 _fmttest/cmp.py 这类仍在用的回归脚本。
_archive/
mes_conv/appicon_preview.png

# ============ 自签名证书（机器相关，不入库） ============
# sign.ps1 生成的公开证书，仅本机/本开发者相关；如需内部分发信任，单独传即可。
签名证书.cer

# ============ 发布清单（构建产物，每次构建重新生成，不入库） ============
.env
version.json
version.sig

# 根目录误生成的配置副本（真实配置在 mes_conv/ 下，别入库）
/orders.json
