    {
      "target": "可生产标识",
      "op": "case",
      "cases": [
        {
          "source": "MB005",
          "match": "eq",
          "value": "110",
          "then": "是"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "裁切",
            "預型",
            "成型",
            "膠合",
            "補磨",
            "塗裝"
          ],
          "then": "是"
        }
      ],
      "default_out": "否"
    },
    {
      "target": "可销售标识",
      "op": "fixed",
      "value": "是"
    },
    {
      "target": "可委外标识",
      "op": "fixed",
      "value": "否"
    },
    {
      "target": "工艺路线名称",
      "op": "case",
      "cases": [
        {
          "source": "MB005",
          "match": "eq",
          "value": "110",
          "then": "包装(đóng gói)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "裁切"
          ],
          "then": "裁切(cắt xén)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "預型"
          ],
          "then": "预型(tiền định hình)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "成型"
          ],
          "then": "成型(Công đoạn tạo hình)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "膠合"
          ],
          "then": "胶合(dán keo / ép keo)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "補磨"
          ],
          "then": "补土(trét bả)"
        },
        {
          "source": "MB002",
          "match": "contains",
          "keywords": [
            "塗裝"
          ],
          "then": "涂装(Sơn khung xe)"
        }
      ]
    }
