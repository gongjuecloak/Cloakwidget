# ============================================================================
# MES 更新镜像服务（通用更新平台） · 配置样例
# 复制为 .env 后填入真实值：  cp .env.example .env
# 重要：.env 含密钥，务必加入 .gitignore，切勿提交到仓库！
#
# 注意：每个「应用」指向哪个 GitHub 仓库，由 apps.json 决定（见 apps.json.example），
# 不在 .env 里。.env 只放全局的令牌类配置。
# ============================================================================

# （可选）GitHub Token：全局，提升 API 速率上限，避免匿名访问的 403 / 限流。
# 留空则用匿名访问（有速率限制，发版不频繁通常够用）。
# 生成：GitHub → Settings → Developer settings → Personal access tokens（只需 public_repo / read 权限）
MIRROR_GITHUB_TOKEN=

# （可选）客户端首次自注册（enroll）的密钥。
# 设置了则客户端须带此 secret 才能注册；配合 MIRROR_ENROLL_OPEN=false 可关闭开放注册。
# 留空 + MIRROR_ENROLL_OPEN=true => 开放注册（局域网内方便，但任何能联网的客户端都可拿令牌）。
# 生成示例： openssl rand -hex 24
MIRROR_ACCESS_TOKEN=

# 是否开放注册（默认 false，更安全）。
#   true  = 任何客户端可自注册（无需密钥，方便但风险高）
#   false = 仅持有 MIRROR_ACCESS_TOKEN 的客户端可注册；若连密钥都没设，则注册完全关闭
MIRROR_ENROLL_OPEN=false

# （可选）后台自动同步周期（秒）。默认 300（5 分钟）。
# 服务启动后会拉起一个后台线程，每隔该周期从 GitHub 拉取各应用发布元数据并写入 SQLite，
# 供控制台（Releases / Assets / Activity / System）展示历史与统计。也可随时用 /admin/refresh 手动触发。
# MIRROR_SYNC_INTERVAL=300

# 管理员令牌：POST /admin/refresh 必须携带（?admin_token= 或请求头 X-Admin-Token）。
# 强烈建议设置；留空则 /admin/refresh 永远返回 401（无人能强制刷新缓存）。
# 生成示例： openssl rand -hex 24
MIRROR_ADMIN_TOKEN=

# （可选）应用注册表路径。默认 ./apps.json（容器内为 /app/apps.json，由 docker-compose 挂载）。
# MIRROR_APPS_JSON=/app/apps.json

# （可选）默认应用 id：老客户端走根路径 /version.json 时落到它。
# 默认取 apps.json 第一个；通常无需改。
# MIRROR_DEFAULT_APP=mes-converter

# ===== 控制台登录（Cloak Update Mirror 控制台需账号密码）=====
# 控制台（概览 / 发布 / 资产 / 活动 / 系统 及对应 JSON API）默认不对外开放，
# 访问会跳转到 /login，必须先登录。避免发布、资产、客户端等内部信息被任意访客看到。
# 用户名，默认 admin。
MIRROR_CONSOLE_USER=admin
# 登录密码：强烈建议设置强密码；留空则服务启动时随机生成（仅本次启动有效，重启后失效）。
# 生成示例： openssl rand -base64 15 | tr -dc 'A-Za-z0-9' | head -c 20
# MIRROR_CONSOLE_PASSWORD=
# 会话有效期（秒），默认 28800 = 8 小时。
# MIRROR_SESSION_TTL=28800
# 在 HTTPS（如经 Cloudflare）前部署时设为 1，给会话 Cookie 加 Secure 标记（更安全）。
MIRROR_SECURE_COOKIE=1

